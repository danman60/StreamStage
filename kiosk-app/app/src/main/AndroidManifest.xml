<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =================================================================== -->
    <!-- INTERNET. Added deliberately, on 2026-08-07, for exactly one         -->
    <!-- feature: the "Update films" panel, which Daniel opens from the       -->
    <!-- remote (MENU, or a long press of SELECT) when he wants new films.    -->
    <!--                                                                      -->
    <!-- This file used to say "there is deliberately no INTERNET here" and    -->
    <!-- that comment was load-bearing, so read what actually changed:        -->
    <!--                                                                      -->
    <!--   * The app still NEVER reaches out on its own. There is no boot      -->
    <!--     check, no background poll, no WorkManager job, no alarm and no    -->
    <!--     timer anywhere in this codebase. Grep for one. The only calls     -->
    <!--     into UpdateManager come from a key press.                         -->
    <!--   * Playback still never touches the network. Playlist reads the      -->
    <!--     local folder; ExoPlayer is given file:// URIs and has no HTTP     -->
    <!--     data source in its dependency graph (no media3-datasource-okhttp, -->
    <!--     no HLS, no DASH — see app/build.gradle.kts).                      -->
    <!--   * Airplane mode is still a supported, tested configuration. With no -->
    <!--     network the loop plays exactly as before and says nothing about   -->
    <!--     it. Only the panel mentions the network, and only when opened.    -->
    <!--                                                                      -->
    <!-- ACCESS_NETWORK_STATE comes back for the same reason (media3 declares  -->
    <!-- it anyway; it is now honest rather than stripped).                    -->
    <!--                                                                      -->
    <!-- If you are auditing this app and want the old guarantee back for a    -->
    <!-- specific show, remove these two lines and rebuild: the updater fails  -->
    <!-- closed with "no network — the loop is unaffected" and nothing else    -->
    <!-- changes.                                                             -->
    <!-- =================================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Added 2026-08-08, for the booth bus (BoothBus.kt): the stick subscribes to the kiosk's
         GET /bus so the tablet and the phone can drive it, and publishes its own state back.

         ACCESS_WIFI_STATE + CHANGE_WIFI_MULTICAST_STATE are for ONE thing: receiving the kiosk's
         UDP discovery beacon (expo-assets/kiosk/BEACON.md). Android wifi drivers filter broadcast
         frames out to save power unless an app holds a MulticastLock — and a Fire Stick sitting
         still playing a reel is exactly the idle state that filtering targets. Without the lock
         the beacon arrives on some devices and silently never arrives on others.

         Neither grants any capability beyond what INTERNET already does, and neither is on the
         playback path. With no kiosk, no wifi and no beacon, the reel plays exactly as it does
         with none of this present. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Added 2026-08-07, and it is the difference between a booth TV and an advertisement for
         Netflix. This stick runs Fire OS on Android 11 (SDK 30), which BLOCKS an activity start
         from a BOOT_COMPLETED receiver: the app boots, plays the reel with sound, and the Amazon
         home screen sits on top of it. Measured on the real stick — the reel was at 61.8s while
         the TV showed "Discover original episodes" and a row of Netflix/Prime/Luna tiles.

         SYSTEM_ALERT_WINDOW is the documented exemption from that rule, granted on the bench with

             adb shell appops set com.streamstage.boothloop SYSTEM_ALERT_WINDOW allow

         MEASURED RESULT ON THIS STICK: NOT SUFFICIENT. With the appop set to "allow", a reboot
         still logged `isBgStartWhitelisted: false` and the Amazon launcher still owned the
         screen. The permission is kept because it is the right lever and behaves differently
         across Fire OS builds, but DO NOT read its presence as "boot autostart works" — it does
         not, and BOOT-AUTOSTART IS AN OPEN DEFECT. See kiosk-app/README.md.

         What IS proven to work, instantly, every time:
             adb shell am start -n com.streamstage.boothloop/.BoothLoopActivity
         and selecting the app once on the Fire TV remote. Either wins the screen back. -->
    <!-- Nothing in this app draws an overlay. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Keeps the stick from hitting its own sleep timer mid-show.
         FLAG_KEEP_SCREEN_ON alone is not enough on Fire OS — see BoothLoopActivity. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Read the films from shared storage (/sdcard/Movies/StreamStageBooth).
         Required because Fire OS 8 blocks adb from writing app-private external storage, so
         the films cannot live somewhere permission-free. Verified on the booth stick:
             adb shell ls /sdcard/Android/data/  ->  Permission denied

         This is a READ permission on a folder we put there ourselves. It grants no network
         capability of any kind. On the dedicated booth stick it is granted non-interactively:
             adb shell pm grant com.streamstage.boothloop android.permission.READ_EXTERNAL_STORAGE

         maxSdkVersion 32 because API 33+ replaced it with the per-media-type permission below. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Write the films back — the only reason this exists is the update panel replacing a
         film with a newer one, in the same folder push-media.sh already uses.

         Why the big hammer on API 30+: /sdcard/Movies is a scoped media collection. Android 11
         lets an app write *media* files there by raw path but refuses anything else (a `.part`
         or a `.json` gets EPERM — measured on this stick), and it will not let an app replace
         a file that a different uid created, which is exactly what an update does because the
         films were pushed over adb. MediaStore's createWriteRequest() is the sanctioned way
         round that and it puts a consent dialog on the TV, which is not something a booth
         stick with a five-button remote can answer.

         So on the dedicated booth stick this is granted once, non-interactively, from the
         laptop, in the same breath as the read permission:

             adb shell appops set (dash dash)uid com.streamstage.boothloop \
                 MANAGE_EXTERNAL_STORAGE allow

         (written out because an XML comment cannot contain two hyphens in a row; the README
         has the copy-pasteable version.)

         If it is NOT granted, nothing breaks: the app reads and plays exactly as before and
         the update panel says the films folder is read-only and prints that command. The loop
         has never needed to write anything. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Leanback declared so Fire TV / Android TV treat this as a TV app, but NOT required,
         so the same APK still installs on a phone or tablet for bench testing. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.BoothLoop">

        <activity
            android:name=".BoothLoopActivity"
            android:exported="true"
            android:banner="@drawable/app_banner"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:theme="@style/Theme.BoothLoop"
            android:excludeFromRecents="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density|touchscreen">

            <!-- LEANBACK_LAUNCHER puts it on the Fire TV home row.
                 LAUNCHER keeps it launchable from a phone/tablet launcher for bench tests.

                 HOME + DEFAULT are the DanTV shape, and they are the reason DanTV survives on a
                 real stick. Registering as a home app means the booth stick can be told to use
                 this as its launcher, which buys two things nothing else can:

                   1. HOME stops being an escape hatch. No app can intercept the HOME key, so
                      without this a visitor pressing it drops the booth TV to the Fire OS
                      launcher mid-show. As the home app, HOME just returns here.
                   2. Autostart after a power cut actually works. Fire OS 8 restricts background
                      activity starts, so BootReceiver alone is unreliable — but the home app is
                      started by the system at boot by definition.

                 Fire OS asks which launcher to use the first time and offers "Always". This is a
                 dedicated booth stick, and it is reversible from Settings > Applications. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Best-effort autostart after a power cycle. See README: background activity
             starts are restricted on Android 10+ / Fire OS 8, so this is NOT guaranteed
             and is NOT the primary recovery path. -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- Fire OS / older devices also emit these. Harmless where unsupported. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
